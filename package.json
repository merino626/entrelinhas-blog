{
  "name": "blog-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:api": "pnpm --filter @blog/api run dev",
    "dev:web": "pnpm --filter @blog/web run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r run lint"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.26",
      "nanoid": "^3.3.18",
      "fast-uri": "^3.1.5",
      "browserslist": "^4.28.7",
      "deepmerge-ts": "^8.0.0",
      "@nestjs/swagger>js-yaml": "^4.3.1",
      "cosmiconfig>js-yaml": "^4.3.1",
      "minimatch@3>brace-expansion": "^1.1.18",
      "minimatch@10>brace-expansion": "^5.0.9"
    }
  }
}
