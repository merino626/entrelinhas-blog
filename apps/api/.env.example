# ── Banco (Supabase Postgres) ────────────────────────────────────────────────
# Senha com caracteres especiais deve ser percent-encoded.
# Pooler (IPv4) recomendado em redes sem IPv6; host direto: db.<ref>.supabase.co:5432
DATABASE_URL="postgresql://postgres.<ref>:<senha-encoded>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<senha-encoded>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# ── Supabase (Dashboard → Settings → API) ────────────────────────────────────
SUPABASE_URL="https://<ref>.supabase.co"
# Chave pública (anon / publishable)
SUPABASE_ANON_KEY=""
# Chave secreta (service_role / secret) — NUNCA expor no frontend
SUPABASE_SERVICE_ROLE_KEY=""
# Opcional: JWT secret legado (Settings → API → JWT Secret). Se vazio, a API
# valida tokens via JWKS (projetos novos com signing keys assimétricas).
SUPABASE_JWT_SECRET=""

# ── API ──────────────────────────────────────────────────────────────────────
PORT=3001
# Origem(ns) do frontend para CORS, separadas por vírgula
WEB_ORIGIN="http://localhost:3000"
# Cookies do refresh token: em produção cross-domain use SAMESITE=none e SECURE=true
COOKIE_SAMESITE="lax"
COOKIE_SECURE="false"
